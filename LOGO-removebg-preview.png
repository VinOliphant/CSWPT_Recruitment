<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 520 120" width="520" height="120">
  <defs>
    <linearGradient id="cswGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00A3E0"/>
      <stop offset="100%" stop-color="#005691"/>
    </linearGradient>
  </defs>

  <!-- Wind Turbine Icon Symbol -->
  <g transform="translate(10, 10)">
    <path d="M 50,50 C 45,20 60,5 75,10 C 70,30 60,45 50,50 Z" fill="url(#cswGradient)" />
    <path d="M 50,50 C 75,55 90,70 85,85 C 65,80 55,65 50,50 Z" fill="#005691" />
    <path d="M 50,50 C 30,75 15,60 20,45 C 35,50 45,50 50,50 Z" fill="#002B49" />
    <circle cx="50" cy="50" r="10" fill="#00A3E0" stroke="#FFFFFF" stroke-width="3"/>
  </g>

  <!-- Typography CS WIND PT -->
  <text x="120" y="65" font-family="'Myriad Pro', 'Inter', Arial, sans-serif" font-size="52" font-weight="900" fill="#002B49" letter-spacing="-1">CS</text>
  <text x="185" y="65" font-family="'Myriad Pro', 'Inter', Arial, sans-serif" font-size="52" font-weight="700" font-style="italic" fill="#00A3E0" letter-spacing="-1">WIND</text>

  <rect x="335" y="26" width="60" height="42" rx="6" fill="#005691"/>
  <text x="365" y="55" font-family="'Myriad Pro', 'Inter', Arial, sans-serif" font-size="24" font-weight="900" fill="#FFFFFF" text-anchor="middle">PT</text>

  <text x="122" y="92" font-family="'Myriad Pro', 'Inter', Arial, sans-serif" font-size="14" font-weight="700" fill="#64748B" letter-spacing="3">SEVER DO VOUGA &amp; GAFANHA DA NAZARÉ</text>
</svg>
